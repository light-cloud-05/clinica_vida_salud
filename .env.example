APP_ENV=local
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=clinica_vida_salud
DB_SCHEMA=public
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=prefer
# Desactivado por defecto. Generar un secreto aleatorio de al menos 32 caracteres.
DB_CHECK_ENABLED=false
DB_CHECK_TOKEN=
# Mantener desactivado hasta autorizar pruebas de alta/edición en la base real.
PATIENT_WRITES_ENABLED=false
# P3: solo habilitar después de autorizar pruebas controladas de escritura.
MEDICAL_WRITES_ENABLED=false
# P4: no habilitar sin autorización para pruebas controladas.
SCHEDULE_WRITES_ENABLED=false
# P5-B: habilitar solo después de autorizar la prueba persistente.
APPOINTMENT_WRITES_ENABLED=false
# P5-C: independiente de reservas; habilitar solo con prueba de escritura autorizada.
APPOINTMENT_CHANGES_ENABLED=false
