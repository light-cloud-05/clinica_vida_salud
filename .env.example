APP_ENV=local
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=clinica_vida_salud
DB_SCHEMA=public
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=prefer
# Desactivado por defecto. Generar un secreto aleatorio de al menos 32 caracteres.
DB_CHECK_ENABLED=false
DB_CHECK_TOKEN=
# Mantener desactivado hasta autorizar pruebas de alta/edición en la base real.
PATIENT_WRITES_ENABLED=false
# CU15: mantener deshabilitado hasta autorizar altas controladas en una copia aislada.
PATIENT_ACCOUNT_WRITES_ENABLED=false
# CU16: mantener deshabilitado hasta configurar y verificar un transporte de correo.
PASSWORD_RECOVERY_WRITES_ENABLED=false
PASSWORD_RESET_TRANSPORT=local
PASSWORD_RESET_FROM=no-reply@clinica-vida-salud.local
# CU20: mantener deshabilitado hasta autorizar ediciones controladas en una copia aislada.
PATIENT_PROFILE_WRITES_ENABLED=false
# P3: solo habilitar después de autorizar pruebas controladas de escritura.
MEDICAL_WRITES_ENABLED=false
# P4: no habilitar sin autorización para pruebas controladas.
SCHEDULE_WRITES_ENABLED=false
# P5-B: habilitar solo después de autorizar la prueba persistente.
APPOINTMENT_WRITES_ENABLED=false
# P5-C: independiente de reservas; habilitar solo con prueba de escritura autorizada.
APPOINTMENT_CHANGES_ENABLED=false
ATTENDANCE_WRITES_ENABLED=false
# P7: mantener deshabilitado; las altas y modificaciones se prueban en simulaciones.
USER_WRITES_ENABLED=false
# P9: mantener deshabilitado; los ensayos usan var/p9 y no PostgreSQL.
PAYMENT_WRITES_ENABLED=false
# P9 persistente: lista explícita de citas de una prueba controlada autorizada.
PAYMENT_ALLOWED_APPOINTMENTS=
